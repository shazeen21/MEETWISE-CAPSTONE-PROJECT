# ========================================================
# MeetWise AI Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ========================================================

# 1. Database Connection
# For PostgreSQL: postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>
# For local SQLite development/testing: sqlite:///./data/meetwise.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/meetwise_db

# 2. LLM API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Hugging Face Access Token (for pyannote.audio diarization)
# Requires accepting model agreements on Hugging Face:
# - pyannote/speaker-diarization-3.1
# - pyannote/segmentation-3.0
HF_TOKEN=your_huggingface_token_here

# 4. WhisperX Speech Recognition Configuration
# Models: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=base
# Device: cuda (for NVIDIA GPU) or cpu
WHISPER_DEVICE=cpu
# Compute Type: float16 (GPU default) or int8 (CPU default)
WHISPER_COMPUTE_TYPE=int8

# 5. Denoising / Enhancement
# Options: spectral, deep, passthrough
DENOISER_TYPE=spectral

# 6. BAAI BGE Embedding Model Configuration
# Models: BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5, BAAI/bge-large-en-v1.5
BGE_MODEL=BAAI/bge-small-en-v1.5

# 7. ChromaDB Persistence
CHROMA_PERSIST_DIR=./data/chromadb

# 8. Server Host & Port
HOST=0.0.0.0
PORT=8000

